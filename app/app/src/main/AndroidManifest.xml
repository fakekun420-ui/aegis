<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Companion necesita control total -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- ===== Almacenamiento: para dejar de usar root =====
         MEDIDO 2026-10-02: esto hablaba de `backend/.aegis_token`, el secreto compartido con el
         Hub. Sin Hub no hay a quien autenticarle: ese fichero ya no existe, y con el la razon
         original de este permiso.
         PERO el permiso SE QUEDA, y hay que decir por que, porque quitarlo sin medir seria lo
         contrario: la app lee y escribe en /sdcard/projects/ (estado del instalador en
         app/state/, registro de proyectos, adjuntos de los chats) y con el almacenamiento con
         ambito de Android 11+ no llega sin MANAGE_EXTERNAL_STORAGE. Lo que se quito fue el
         uso de ROOT para leer un fichero; el acceso al almacenamiento se sigue necesitando.
         MANAGE_EXTERNAL_STORAGE es el permiso que realmente da acceso a todo
         /sdcard. NO se concede con un diálogo normal: hay que abrir Ajustes →
         "Acceso a todos los archivos", y por eso la app lanza ese intent explícitamente
         (ver MainActivity → ensureAllFilesAccess). Read/Write se declaran con
         maxSdkVersion="32" porque desde Android 13 están obsoletos y el sistema ya no
         concede nada con ellos: se dejan solo para instalaciones antigas. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Cámara: la app ya expone captura de imagen en el compositor. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- ROOT vía su, no necesita permiso declarado -->
    <!-- A-6 (seguridad / red profunda):
         android:usesCleartextTraffic se mantiene en `true` DE FORMA DELIBERADA.
         La app solo se comunica con el hub local http://127.0.0.1:8765 (sin
         hosts http externos); ponerlo en `false` bloquearía también el cleartext
         hacia loopback y rompería el hub (la app quedaría siempre OFFLINE).
         DECISIÓN documentada (backlog técnico F0-F2) — NO se sustituye por un
         android:networkSecurityConfig: el XML de configuración de red de Android
         sólo permite allowlist de cleartext por NOMBRES DE DOMINIO
         (<domain-config><domain>…</domain>); un literal IP de loopback
         (127.0.0.1) no es un dominio y no puede listarse de forma fiable, así
         que un cleartextTrafficPermitted=false global (base-config) cortaría
         también http://127.0.0.1:8765 (hub) y la app quedaría OFFLINE: no
         existe forma declarativa de "sólo cleartext a loopback". Por eso `true`
         es la opción correcta AQUÍ. Los mitigantes reales viven en el backend,
         no en este flag: el hub sólo hace bind a 127.0.0.1 (loopback, F0 A-1.2)
         y exige X-Aegis-Token timing-safe en /api/* y /opencode/* (única
         exención: GET /api/health), de modo que ni otras apps del dispositivo
         ni la red pueden invocarlo sin token.
         Deep link: no existe ninguno (solo MAIN/LAUNCHER; sin scheme, sin
         BROWSABLE, sin autoVerify). No se declara `aegis://` porque no hay
         assetlinks.json ni pantalla que lo reciba: añadirlo sin verificación
         abriría la app desde cualquier origen. -->
    <application
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:roundIcon="@android:mipmap/sym_def_app_icon"
        android:label="Aegis"
        android:theme="@style/Theme.AegisHub"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AegisHub"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
