<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Companion necesita control total -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- ===== Almacenamiento: para dejar de usar root =====
         Sin esto, con el almacenamiento con ámbito de Android 11+, la app NO puede leer
         /sdcard/projects/Aegis/backend/.aegis_token por ninguna vía que no sea root, y
         paraConseguirlo hacía `su -c cat` en cada petición (la caché duraba 2 s y los
         polls son de 1,5 s): un prompt de root cada 1,5 segundos.
         MANAGE_EXTERNAL_STORAGE es el permiso que realmente da acceso a todo
         /sdcard. NO se concede con un diálogo normal: hay que abrir Ajustes →
         "Acceso a todos los archivos", y por eso la app lanza ese intent explícitamente
         (ver MainActivity → ensureAllFilesAccess). Read/Write se declaran con
         maxSdkVersion="32" porque desde Android 13 están obsoletos y el sistema ya no
         concede nada con ellos: se dejan solo para instalaciones antigas. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Cámara: la app ya expone captura de imagen en el compositor. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- ROOT vía su, no necesita permiso declarado -->
    <!-- A-6 (seguridad / red profunda):
         android:usesCleartextTraffic se mantiene en `true` DE FORMA DELIBERADA.
         La app solo se comunica con el hub local http://127.0.0.1:8765 (sin
         hosts http externos); ponerlo en `false` bloquearía también el cleartext
         hacia loopback y rompería el hub (la app quedaría siempre OFFLINE).
         DECISIÓN documentada (backlog técnico F0-F2) — NO se sustituye por un
         android:networkSecurityConfig: el XML de configuración de red de Android
         sólo permite allowlist de cleartext por NOMBRES DE DOMINIO
         (<domain-config><domain>…</domain>); un literal IP de loopback
         (127.0.0.1) no es un dominio y no puede listarse de forma fiable, así
         que un cleartextTrafficPermitted=false global (base-config) cortaría
         también http://127.0.0.1:8765 (hub) y la app quedaría OFFLINE: no
         existe forma declarativa de "sólo cleartext a loopback". Por eso `true`
         es la opción correcta AQUÍ. Los mitigantes reales viven en el backend,
         no en este flag: el hub sólo hace bind a 127.0.0.1 (loopback, F0 A-1.2)
         y exige X-Aegis-Token timing-safe en /api/* y /opencode/* (única
         exención: GET /api/health), de modo que ni otras apps del dispositivo
         ni la red pueden invocarlo sin token.
         Deep link: no existe ninguno (solo MAIN/LAUNCHER; sin scheme, sin
         BROWSABLE, sin autoVerify). No se declara `aegis://` porque no hay
         assetlinks.json ni pantalla que lo reciba: añadirlo sin verificación
         abriría la app desde cualquier origen. -->
    <application
        android:allowBackup="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:roundIcon="@android:mipmap/sym_def_app_icon"
        android:label="Aegis"
        android:theme="@style/Theme.AegisHub"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AegisHub"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Hub local opencode es externo (node); este servicio es el bridge a11y + http 8766 -->
        <service
            android:name=".CompanionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="opencode-device-bridge"/>
        </service>
                <!-- VoiceInteractionService — selectable as default assistant (Settings → Default Apps → Digital Assistant) -->
        <service
            android:name=".CompanionVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service_config" />
        </service>
        <service
            android:name=".CompanionVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />
        <activity
            android:name=".CompanionVoiceInteractionSessionActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
