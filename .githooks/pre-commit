#!/bin/sh
# graphify-staleness — hook pre-commit
#
# Este hook NO tiene la lógica: la delega entera en .githooks/stale-check.py,
# que es la fuente de verdad del proyecto y la misma que llama el plugin
# .opencode/plugins/graphify-staleness.js para el aviso. Un solo chequeo, dos
# momentos: aquí bloquea, allí avisa. Si divergieran, un agente leería "al día"
# y luego no podría commitear: por eso no hay dos implementaciones.
#
# Vive fuera de OpenCode: lo ejecuta `git commit`, así que se comporta igual
# desde un agente, desde agy, desde una edición manual o desde Termux.
#
# -- Por qué la copia ejecutable no está en el repo ---------------------------
# /sdcard está montado noexec y su chmod es un no-op (el modo se queda en 660),
# así que git descarta cualquier hook que viva dentro del repo — se deduce con
# "hint: the hook was ignored because it's not set as executable" y el commit
# pasa igual. Verificado en Aegis el 2026-09-27 con .git/hooks/pre-commit y con
# .githooks/pre-commit. La fuente (este repo) es versionable; la copia que git
# ejecuta la pone .githooks/install.sh en ~/.git-hooks/<repo>/ y core.hooksPath
# apunta ahí. El hook resuelve la raíz con git rev-parse --show-toplevel, luego
# da igual desde dónde se lance.
#
# -- Qué NO garantiza ---------------------------------------------------------
# · graphify update refresca el ast_hash de los .md pero NO reingiere su texto en
#   el grafo (los documentos solo se reindexan con `/graphify --update`). Tras un
#   commit que solo toca docs, este hook pasa y el grafo puede no contener el
#   texto nuevo. Ningún test de manifest detecta eso.
# · `graphify update` sobre /sdcard puede fallar al final, al renombrar el
#   atómico: "Rebuild failed: ... .graph.tmp.json -> graph.json". Es el FUSE de
#   §2, es transitorio y se arregla reintentando. Si ves ese error, reintenta.
# · `--no-verify` salta el hook. Inherente a git: reduce la vía por defecto, no la
#   elimina.
# · Un agente con shell puede `git config --unset core.hooksPath`. No es una
#   defensa contra un actor hostil; es un guardián por defecto.
#
# -- Puesta en marcha tras un clone nuevo --------------------------------------
#   sh .githooks/install.sh
#
# Salida de emergencia:  GRAPHIFY_SKIP_HOOK=1 git commit ...   (avisa por stderr)
# Verbose:                GRAPHIFY_HOOK_VERBOSE=1 git commit ...

set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$ROOT" ] || exit 0
cd "$ROOT" || exit 0

OUT="graphify-out"
[ -f "$OUT/manifest.json" ] && [ -f "$OUT/graph.json" ] || exit 0

if [ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ]; then
    echo "graphify: commit NO verificado (GRAPHIFY_SKIP_HOOK=1)." >&2
    exit 0
fi

CHECK="$ROOT/.githooks/stale-check.py"
if [ ! -f "$CHECK" ]; then
    {
        echo "================================================================"
        echo " graphify: COMMIT BLOQUEADO - no encuentro el chequeo"
        echo "================================================================"
        echo "  Falta $CHECK"
        echo ""
        echo "  Sin él no puedo comparar md5 y no voy a dejar pasar un commit"
        echo "  a ciegas. Recupéralo con:"
        echo "    git show HEAD:.githooks/stale-check.py > $CHECK"
        echo "  o salta este commit:"
        echo "    GRAPHIFY_SKIP_HOOK=1 git commit -m '...'"
        echo "================================================================"
    } >&2
    exit 1
fi

# --- localizar un intérprete python con graphify importable -------------------
GPY=""
if command -v graphify >/dev/null 2>&1; then
    GPY=$(head -1 "$(command -v graphify)" 2>/dev/null | sed 's/^#!\(.*\)$/\1/')
    [ -x "$GPY" ] || GPY=""
fi
if [ -z "$GPY" ] && [ -f "$OUT/.graphify_python" ]; then
    GPY=$(cat "$OUT/.graphify_python" 2>/dev/null)
    [ -x "$GPY" ] || GPY=""
fi
for cand in python3 python; do
    [ -n "$GPY" ] && break
    command -v "$cand" >/dev/null 2>&1 || continue
    "$cand" -c 'import graphify.detect' >/dev/null 2>&1 && GPY=$(command -v "$cand")
done
if [ -z "$GPY" ]; then
    {
        echo "================================================================"
        echo " graphify: COMMIT BLOQUEADO - no puedo comprobar el mapa"
        echo "================================================================"
        echo "  No encuentro un python con graphify importable. Busqué:"
        echo "    - el intérprete del propio 'graphify' (shebang)"
        echo "    - $OUT/.graphify_python"
        echo "    - python3 / python del PATH"
        echo ""
        echo "  Sin el, el hook no puede comparar md5 y no va a dejar pasar"
        echo "  un commit a ciegas. Arregla el toolchain (pkg install python"
        echo "  en Termux, o graphify en el chroot) o salta este commit:"
        echo "    GRAPHIFY_SKIP_HOOK=1 git commit -m '...'"
        echo "================================================================"
    } >&2
    exit 1
fi

exec "$GPY" "$CHECK" --root "$ROOT"
